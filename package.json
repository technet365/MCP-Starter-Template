{
  "name": "mcp-starter-template",
  "version": "1.0.0",
  "description": "Minimal TypeScript template for building MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "llm",
    "typescript",
    "template",
    "starter"
  ],
  "author": "technet365",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/technet365/MCP-Starter-Template.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^25.6.0",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
